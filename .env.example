# LLM backends (Section 10.3)

# Primary Groq API key (required for data generation)
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# Optional: Additional Groq keys for round-robin rotation
# When the primary key hits rate limits, the backend auto-switches to the next key.
# Add as many as you have (GROQ_API_KEY_2, GROQ_API_KEY_3, GROQ_API_KEY_4, ...)
GROQ_API_KEY_2=your_second_groq_key_here
GROQ_API_KEY_3=your_third_groq_key_here
GROQ_API_KEY_4=your_fourth_groq_key_here

# Local / open-weight endpoint (Llama, Qwen) for bulk data generation (Section 8.3)
# Only needed if using Ollama instead of Groq
LOCAL_MODEL_ENDPOINT=http://localhost:11434/v1

# Storage
DATABASE_URL=sqlite:///data/processed/drift.db
